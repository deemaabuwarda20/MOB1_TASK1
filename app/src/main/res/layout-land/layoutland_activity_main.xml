<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:ignore="MissingDefaultResource">

    <Button
        android:id="@+id/button_toast"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Toast"
        android:onClick="showToast"
        app:layout_constraintTop_toTopOf="@id/show_count"
        app:layout_constraintBottom_toTopOf="@id/button_zero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/show_count"
        tools:ignore="OnClick" />

    <Button
        android:id="@+id/button_zero"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@android:color/darker_gray"
        android:onClick="showZero"
        android:text="Zero"
        app:layout_constraintBottom_toTopOf="@id/button_count"
        app:layout_constraintEnd_toStartOf="@id/show_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_toast"
        tools:ignore="OnClick" />

    <Button
        android:id="@+id/button_count"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Count"
        android:onClick="showCount"
        app:layout_constraintTop_toBottomOf="@id/button_zero"
        app:layout_constraintBottom_toBottomOf="@id/show_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/show_count"/>

    <TextView
        android:id="@+id/show_count"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:layout_margin="20dp"
        android:background="@android:color/holo_orange_light"
        android:gravity="center"
        android:text="0"
        android:textSize="120sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button_zero"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.756" />

    <TextView
        android:id="@+id/textBar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#8D63D9"
        android:padding="10dp"
        android:text="@string/hello_constraint"
        android:textColor="#F4EAEA"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.022" />


</androidx.constraintlayout.widget.ConstraintLayout>